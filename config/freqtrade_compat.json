{
  "bot_name": "quant-cn-freqtrade-route",
  "strategy": "EMATrendStrategy",
  "dry_run": true,
  "max_open_trades": 1,
  "stake_currency": "USDT",
  "dry_run_wallet": {
    "USDT": 10000
  },
  "timeframe": "1m",
  "fee": 0.001,
  "db_url": "sqlite:///data/freqtrade_compat.db",
  "exchange": {
    "name": "binance",
    "sandbox": false,
    "pair_whitelist": [
      "BTC/USDT",
      "ETH/USDT"
    ]
  },
  "api_server": {
    "enabled": true,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8765
  },
  "quant": {
    "risk": {
      "max_trade_risk_pct": 0.005,
      "daily_loss_limit_pct": 0.02,
      "max_loss_streak": 3,
      "atr_period": 14,
      "atr_stop_mult": 1.5,
      "atr_take_profit_mult": 3.0,
      "slippage_bps": 8.0,
      "allow_live": false,
      "allow_margin": false,
      "allow_futures": false,
      "allow_martingale": false,
      "allow_grid_average_down": false
    },
    "execution": {
      "retry_attempts": 3,
      "retry_backoff_sec": 1.0,
      "request_timeout_sec": 10.0,
      "paper_fill_model": "close_with_slippage",
      "default_order_type": "market",
      "paper_initial_cash": 10000.0,
      "monitor_reference_cash": 10000.0
    },
    "strategy_parameters": {
      "EMATrendStrategy": {
        "fast_period": 9,
        "slow_period": 21,
        "atr_period": 14,
        "min_trend_strength": 0.0
      },
      "RSIBBandsMeanReversionStrategy": {
        "rsi_period": 14,
        "rsi_overbought": 72,
        "rsi_oversold": 28,
        "bb_period": 20,
        "bb_stddev": 2.0,
        "exit_at_midline": true
      }
    }
  }
}
